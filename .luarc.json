{
  "runtime.version": "LuaJIT",
  "runtime.path": [
    "lua/?.lua",
    "lua/?/init.lua"
  ],
  "diagnostics.globals": [
    "vim",
    "MiniCompletion",
    "MiniExtra",
    "MiniFiles",
    "MiniKeymap",
    "MiniPick"
  ],
  "workspace.checkThirdParty": false,
  "workspace.library": [
    "$VIMRUNTIME/lua",
    "${3rd}/luv/library"
  ]
}
